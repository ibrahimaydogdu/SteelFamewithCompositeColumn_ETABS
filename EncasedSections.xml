<?xml version="1.0" encoding="utf-8"?>
<!--
  Encased composite column settings (AISC 360-16, see KULLANIM_KILAVUZU.md).
  Every W section of the library produces one encased section:
    H = W depth  + 2 * ConcreteCover  (rounded up to DimensionRounding, >= MinDimension)
    B = W flange + 2 * ConcreteCover  (rounded up to DimensionRounding, >= MinDimension)
    bars: perimeter layout, bars per face increased from MinBarsPerFace until rho_sr >= 0.004
  Lengths in mm. Materials must exist in the ETABS model.
-->
<EncasedSettings>
  <ConcreteMaterial>4000Psi</ConcreteMaterial>
  <RebarMaterial>A615Gr60</RebarMaterial>
  <ConcreteCover>75</ConcreteCover>
  <RebarCover>50</RebarCover>
  <RebarDiameter>20</RebarDiameter>
  <MinBarsPerFace>2</MinBarsPerFace>
  <MaxBarsPerFace>6</MaxBarsPerFace>
  <DimensionRounding>50</DimensionRounding>
  <MinDimension>300</MinDimension>
  <!-- effective length factors (buckling about local 2 / local 3) and sway amplifier B2 (1.0 = P-Delta analysis) -->
  <K22>1.0</K22>
  <K33>1.0</K33>
  <B2>1.0</B2>
  <SectionPrefix>EC_</SectionPrefix>
  <!-- relative unit costs of the objective function in composite mode -->
  <SteelUnitCost>1.0</SteelUnitCost>       <!-- per kN structural steel -->
  <RebarUnitCost>0.8</RebarUnitCost>       <!-- per kN reinforcement -->
  <ConcreteUnitCost>0.8</ConcreteUnitCost> <!-- per m3 concrete -->
  <FormworkUnitCost>0.2</FormworkUnitCost> <!-- per m2 formwork -->
</EncasedSettings>
